{
  "name": "@collab/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "typecheck": "bunx tsc --noEmit",
    "perf:users:seed": "bun run --filter @collab/backend perf:users:seed",
    "perf:users:cleanup": "bun run --filter @collab/backend perf:users:cleanup",
    "test:perf:e2e": "bun run perf:users:seed && (bunx playwright test --config=playwright.config.ts perf-tests/performance.spec.ts; EXIT_CODE=$?; bun run perf:users:cleanup; exit $EXIT_CODE)",
    "test:perf:e2e:ci": "bun run perf:users:seed && (bunx playwright test --reporter=line --config=playwright.config.ts perf-tests/performance.spec.ts; EXIT_CODE=$?; bun run perf:users:cleanup; exit $EXIT_CODE)"
  },
  "dependencies": {
    "@collab/shared": "workspace:*",
    "better-auth": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.2.0",
    "lib0": "0.2.117",
    "lucide-react": "^0.564.0",
    "next": "latest",
    "radix-ui": "^1.4.3",
    "react": "latest",
    "react-dom": "latest",
    "react-konva": "^19.2.2",
    "tailwind-merge": "^3.4.1",
    "y-protocols": "latest",
    "yjs": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  }
}
